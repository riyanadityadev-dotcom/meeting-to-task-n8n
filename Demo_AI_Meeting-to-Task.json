    {
      "parameters": {
        "jsCode": "const d = $('Validasi hasil').first().json;\nreturn d.action_items.map(a => ({ json: {\n  task: a.task || '',\n  owner: a.owner || 'tidak disebutkan',\n  due_date: a.due_date || 'tidak disebutkan',\n  priority: a.priority || 'sedang',\n  source_quote: a.source_quote || '',\n  needs_review: a.needs_review === true ? 'ya' : 'tidak',\n  meeting_title: d.meeting_title,\n  meeting_date: d.meeting_date\n}}));"
      },
